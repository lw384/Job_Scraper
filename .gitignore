.DS_Store
__pycache__/
.venv/

# Personal data — NEVER commit (public repo). CI gets these via Actions secrets.
candidate_profile.md
resume.md
resume.txt
shortlist.*

# ── Fork-owner customization ──────────────────────────────────────────────────
# This personal fork tracks config.json so GitHub Actions and Pages can read it.
# Keep credentials out of it; API keys and private CV data belong in secrets.
scoring_profile.json

# ── Scraped results & CI-generated data (unique per fork) ─────────────────────
# output/ holds everything the scrapers write. Upstream never commits these so
# pulling upstream never creates merge conflicts. Fork owners' CI uses
# "git add -f output/<file>" to commit their own results.
output/*
!output/.gitkeep
